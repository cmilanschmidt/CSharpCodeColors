// VS Fonts and Colors item -> VS Code C# selectors. Comments and trailing commas are allowed.
// VisualStudioItem: the name exactly as `CSharpCodeColors --list` prints it.
// SemanticTokens: "<tokenType>[.<modifier>]:csharp" as sent by the C# extension's Roslyn server.
// TextMateScopes: scopes of VS Code's built-in C# grammar; each must end in ".cs" or start with "source.cs".
//   The defaults are full leaf scopes under "source.cs": a full leaf can't be outranked by a theme rule,
//   and the "source.cs" parent keeps the rules out of C# code blocks in Markdown.
{
  "OutputPath": "settings.json",
  "VsCodeThemeScope": null,
  "Mappings": [
    // Base color of all C# text that no other rule colors.
    { "VisualStudioItem": "Plain Text", "TextMateScopes": [ "source.cs" ] },

    // Comments
    { "VisualStudioItem": "Comment", "SemanticTokens": [ "comment:csharp" ],
      "TextMateScopes": [ "source.cs comment.line.double-slash.cs", "source.cs comment.block.cs", "source.cs punctuation.definition.comment.cs" ] },

    // Keywords. `value` in a setter (elsewhere the grammar also scopes parameters named `value` this way), `this`/`base`, `true`/`false`/`null` are keywords in Roslyn.
    { "VisualStudioItem": "Keyword", "SemanticTokens": [ "keyword:csharp" ],
      "TextMateScopes": [
        "source.cs keyword.type.bool.cs", "source.cs keyword.type.byte.cs", "source.cs keyword.type.sbyte.cs", "source.cs keyword.type.short.cs",
        "source.cs keyword.type.ushort.cs", "source.cs keyword.type.int.cs", "source.cs keyword.type.uint.cs", "source.cs keyword.type.nint.cs",
        "source.cs keyword.type.nuint.cs", "source.cs keyword.type.long.cs", "source.cs keyword.type.ulong.cs", "source.cs keyword.type.float.cs",
        "source.cs keyword.type.double.cs", "source.cs keyword.type.decimal.cs", "source.cs keyword.type.char.cs", "source.cs keyword.type.string.cs",
        "source.cs keyword.type.object.cs", "source.cs keyword.type.void.cs", "source.cs keyword.type.dynamic.cs",
        "source.cs storage.modifier.new.cs", "source.cs storage.modifier.public.cs", "source.cs storage.modifier.protected.cs", "source.cs storage.modifier.internal.cs",
        "source.cs storage.modifier.private.cs", "source.cs storage.modifier.abstract.cs", "source.cs storage.modifier.virtual.cs", "source.cs storage.modifier.override.cs",
        "source.cs storage.modifier.sealed.cs", "source.cs storage.modifier.static.cs", "source.cs storage.modifier.partial.cs", "source.cs storage.modifier.readonly.cs",
        "source.cs storage.modifier.volatile.cs", "source.cs storage.modifier.const.cs", "source.cs storage.modifier.extern.cs", "source.cs storage.modifier.async.cs",
        "source.cs storage.modifier.unsafe.cs", "source.cs storage.modifier.ref.cs", "source.cs storage.modifier.required.cs", "source.cs storage.modifier.file.cs",
        "source.cs storage.modifier.in.cs", "source.cs storage.modifier.out.cs", "source.cs storage.modifier.params.cs", "source.cs storage.modifier.this.cs",
        "source.cs storage.modifier.explicit.cs", "source.cs storage.modifier.implicit.cs", "source.cs storage.modifier.fixed.cs", "source.cs storage.modifier.where.cs",
        "source.cs storage.type.class.cs", "source.cs storage.type.delegate.cs", "source.cs storage.type.enum.cs", "source.cs storage.type.event.cs",
        "source.cs storage.type.interface.cs", "source.cs storage.type.namespace.cs", "source.cs storage.type.operator.cs", "source.cs storage.type.record.cs",
        "source.cs storage.type.struct.cs", "source.cs storage.type.union.cs", "source.cs storage.type.var.cs",
        "source.cs storage.type.accessor.get.cs", "source.cs storage.type.accessor.set.cs", "source.cs storage.type.accessor.init.cs",
        "source.cs storage.type.accessor.add.cs", "source.cs storage.type.accessor.remove.cs",
        "source.cs keyword.other.attribute-specifier.cs", "source.cs keyword.other.constraint.default.cs", "source.cs keyword.other.constraint.notnull.cs",
        "source.cs keyword.other.constraint.unmanaged.cs", "source.cs keyword.other.directive.alias.cs", "source.cs keyword.other.directive.extern.cs",
        "source.cs keyword.other.directive.global.cs", "source.cs keyword.other.directive.static.cs", "source.cs keyword.other.directive.using.cs",
        "source.cs keyword.operator.expression.as.cs", "source.cs keyword.operator.expression.default.cs", "source.cs keyword.operator.expression.new.cs",
        "source.cs keyword.operator.expression.pattern.is.cs", "source.cs keyword.operator.expression.with.cs", "source.cs keyword.operator.expression.checked.cs",
        "source.cs keyword.operator.expression.unchecked.cs", "source.cs keyword.operator.expression.nameof.cs", "source.cs keyword.operator.expression.sizeof.cs",
        "source.cs keyword.operator.expression.typeof.cs", "source.cs keyword.operator.expression.stackalloc.cs",
        "source.cs keyword.operator.expression.pattern.combinator.and.cs", "source.cs keyword.operator.expression.pattern.combinator.or.cs",
        "source.cs keyword.operator.expression.pattern.combinator.not.cs",
        "source.cs keyword.operator.expression.query.ascending.cs", "source.cs keyword.operator.expression.query.by.cs", "source.cs keyword.operator.expression.query.descending.cs",
        "source.cs keyword.operator.expression.query.equals.cs", "source.cs keyword.operator.expression.query.from.cs", "source.cs keyword.operator.expression.query.group.cs",
        "source.cs keyword.operator.expression.query.in.cs", "source.cs keyword.operator.expression.query.into.cs", "source.cs keyword.operator.expression.query.join.cs",
        "source.cs keyword.operator.expression.query.let.cs", "source.cs keyword.operator.expression.query.on.cs", "source.cs keyword.operator.expression.query.orderby.cs",
        "source.cs keyword.operator.expression.query.select.cs", "source.cs keyword.operator.expression.query.where.cs",
        "source.cs keyword.control.context.fixed.cs", "source.cs keyword.control.context.lock.cs", "source.cs keyword.control.context.using.cs",
        "source.cs keyword.control.context.checked.cs", "source.cs keyword.control.context.unchecked.cs", "source.cs keyword.control.context.unsafe.cs",
        "source.cs variable.language.this.cs", "source.cs variable.language.base.cs", "source.cs variable.language.discard.cs", "source.cs meta.accessor.setter.cs variable.other.value.cs",
        "source.cs constant.language.boolean.true.cs", "source.cs constant.language.boolean.false.cs", "source.cs constant.language.null.cs" ] },
    // `await` is a control keyword in Roslyn.
    { "VisualStudioItem": "keyword - control", "SemanticTokens": [ "controlKeyword:csharp" ],
      "TextMateScopes": [
        "source.cs keyword.control.conditional.case.cs", "source.cs keyword.control.conditional.default.cs", "source.cs keyword.control.conditional.else.cs",
        "source.cs keyword.control.conditional.if.cs", "source.cs keyword.control.conditional.switch.cs", "source.cs keyword.control.conditional.when.cs",
        "source.cs keyword.control.exception.catch.cs", "source.cs keyword.control.exception.finally.cs", "source.cs keyword.control.exception.try.cs",
        "source.cs keyword.control.exception.when.cs", "source.cs keyword.control.flow.break.cs", "source.cs keyword.control.flow.continue.cs",
        "source.cs keyword.control.flow.goto.cs", "source.cs keyword.control.flow.return.cs", "source.cs keyword.control.flow.throw.cs",
        "source.cs keyword.control.flow.yield.cs", "source.cs keyword.control.loop.do.cs", "source.cs keyword.control.loop.for.cs",
        "source.cs keyword.control.loop.foreach.cs", "source.cs keyword.control.loop.in.cs", "source.cs keyword.control.loop.while.cs",
        "source.cs keyword.operator.expression.await.cs" ] },

    // Operators and punctuation. Roslyn classifies `.`, `->`, `::`, the nullable `?`, the pointer `*` and the destructor `~` as operators, `..` as punctuation.
    { "VisualStudioItem": "Operator", "SemanticTokens": [ "operator:csharp" ],
      "TextMateScopes": [
        "source.cs keyword.operator.arithmetic.cs", "source.cs keyword.operator.arrow.cs", "source.cs keyword.operator.assignment.cs",
        "source.cs keyword.operator.assignment.compound.cs", "source.cs keyword.operator.assignment.compound.bitwise.cs", "source.cs keyword.operator.bitwise.cs",
        "source.cs keyword.operator.bitwise.shift.cs", "source.cs keyword.operator.comparison.cs", "source.cs keyword.operator.conditional.colon.cs",
        "source.cs keyword.operator.conditional.question-mark.cs", "source.cs keyword.operator.decrement.cs", "source.cs keyword.operator.increment.cs",
        "source.cs keyword.operator.logical.cs", "source.cs keyword.operator.null-coalescing.cs", "source.cs keyword.operator.null-conditional.cs",
        "source.cs keyword.operator.relational.cs", "source.cs punctuation.accessor.cs", "source.cs punctuation.accessor.pointer.cs",
        "source.cs punctuation.separator.coloncolon.cs", "source.cs punctuation.separator.question-mark.cs", "source.cs punctuation.separator.asterisk.cs",
        "source.cs punctuation.tilde.cs" ] },
    { "VisualStudioItem": "operator - overloaded", "SemanticTokens": [ "operatorOverloaded:csharp" ] },
    { "VisualStudioItem": "punctuation", "SemanticTokens": [ "punctuation:csharp" ],
      "TextMateScopes": [
        "source.cs punctuation.curlybrace.open.cs", "source.cs punctuation.curlybrace.close.cs", "source.cs punctuation.parenthesis.open.cs",
        "source.cs punctuation.parenthesis.close.cs", "source.cs punctuation.squarebracket.open.cs", "source.cs punctuation.squarebracket.close.cs",
        "source.cs punctuation.definition.typeparameters.begin.cs", "source.cs punctuation.definition.typeparameters.end.cs",
        "source.cs punctuation.terminator.statement.cs", "source.cs punctuation.separator.comma.cs", "source.cs punctuation.separator.colon.cs",
        "source.cs keyword.operator.range.cs", "source.cs meta.embedded.interpolation.cs",
        "source.cs punctuation.definition.interpolation.begin.cs", "source.cs punctuation.definition.interpolation.end.cs",
        "source.cs meta.embedded.interpolation.cs keyword.operator.conditional.colon.cs" ] },

    // Literals
    { "VisualStudioItem": "Number", "SemanticTokens": [ "number:csharp" ],
      "TextMateScopes": [
        "source.cs constant.numeric.decimal.cs", "source.cs constant.numeric.hex.cs", "source.cs constant.numeric.binary.cs",
        "source.cs constant.numeric.other.exponent.cs", "source.cs constant.numeric.other.preffix.hex.cs", "source.cs constant.numeric.other.preffix.binary.cs",
        "source.cs constant.numeric.other.separator.decimals.cs", "source.cs constant.numeric.other.separator.thousands.cs", "source.cs constant.numeric.other.suffix.cs" ] },
    // Regular, raw and interpolated strings and char literals are all "String" in VS and "string" in Roslyn's legend.
    { "VisualStudioItem": "String", "SemanticTokens": [ "string:csharp" ],
      "TextMateScopes": [
        "source.cs string.quoted.double.cs", "source.cs string.quoted.single.cs", "source.cs punctuation.definition.string.begin.cs",
        "source.cs punctuation.definition.string.end.cs", "source.cs punctuation.definition.char.begin.cs", "source.cs punctuation.definition.char.end.cs" ] },
    { "VisualStudioItem": "string - verbatim", "SemanticTokens": [ "stringVerbatim:csharp" ] },
    { "VisualStudioItem": "string - escape character", "SemanticTokens": [ "stringEscapeCharacter:csharp" ],
      "TextMateScopes": [ "source.cs constant.character.escape.cs" ] },

    // Preprocessor and excluded code. meta.preprocessor.cs covers directive words the grammar doesn't scope (e.g. `#nullable enable`).
    { "VisualStudioItem": "Preprocessor Keyword", "SemanticTokens": [ "macro:csharp" ],
      "TextMateScopes": [
        "source.cs meta.preprocessor.cs", "source.cs punctuation.separator.hash.cs",
        "source.cs keyword.preprocessor.checksum.cs", "source.cs keyword.preprocessor.default.cs", "source.cs keyword.preprocessor.define.cs",
        "source.cs keyword.preprocessor.disable.cs", "source.cs keyword.preprocessor.elif.cs", "source.cs keyword.preprocessor.else.cs",
        "source.cs keyword.preprocessor.endif.cs", "source.cs keyword.preprocessor.endregion.cs", "source.cs keyword.preprocessor.error.cs",
        "source.cs keyword.preprocessor.exclude.cs", "source.cs keyword.preprocessor.hidden.cs", "source.cs keyword.preprocessor.if.cs",
        "source.cs keyword.preprocessor.include.cs", "source.cs keyword.preprocessor.line.cs", "source.cs keyword.preprocessor.load.cs",
        "source.cs keyword.preprocessor.package.cs", "source.cs keyword.preprocessor.pragma.cs", "source.cs keyword.preprocessor.project.cs",
        "source.cs keyword.preprocessor.property.cs", "source.cs keyword.preprocessor.r.cs", "source.cs keyword.preprocessor.ref.cs",
        "source.cs keyword.preprocessor.region.cs", "source.cs keyword.preprocessor.restore.cs", "source.cs keyword.preprocessor.sdk.cs",
        "source.cs keyword.preprocessor.undef.cs", "source.cs keyword.preprocessor.warning.cs" ] },
    { "VisualStudioItem": "preprocessor text", "SemanticTokens": [ "preprocessorText:csharp" ],
      "TextMateScopes": [ "source.cs string.unquoted.preprocessor.message.cs" ] },
    { "VisualStudioItem": "Excluded Code", "SemanticTokens": [ "excludedCode:csharp" ] },

    // XML documentation comments. Selectors with more parent scopes win over the generic comment/string rules.
    { "VisualStudioItem": "xml doc comment - text", "SemanticTokens": [ "xmlDocCommentText:csharp" ],
      "TextMateScopes": [ "source.cs comment.block.documentation.cs" ] },
    { "VisualStudioItem": "xml doc comment - delimiter", "SemanticTokens": [ "xmlDocCommentDelimiter:csharp" ],
      "TextMateScopes": [
        "source.cs comment.block.documentation.cs punctuation.definition.comment.cs", "source.cs comment.block.documentation.cs punctuation.definition.tag.cs",
        "source.cs comment.block.documentation.cs punctuation.separator.equals.cs",
        "source.cs comment.block.documentation.cs comment.block.cs punctuation.definition.comment.cs",
        "source.cs comment.block.documentation.cs string.unquoted.cdata.cs punctuation.definition.string.begin.cs",
        "source.cs comment.block.documentation.cs string.unquoted.cdata.cs punctuation.definition.string.end.cs" ] },
    { "VisualStudioItem": "xml doc comment - name", "SemanticTokens": [ "xmlDocCommentName:csharp" ],
      "TextMateScopes": [ "source.cs entity.name.tag.cs", "source.cs entity.name.tag.localname.cs", "source.cs entity.name.tag.namespace.cs" ] },
    { "VisualStudioItem": "xml doc comment - attribute name", "SemanticTokens": [ "xmlDocCommentAttributeName:csharp" ],
      "TextMateScopes": [ "source.cs entity.other.attribute-name.cs", "source.cs entity.other.attribute-name.localname.cs", "source.cs entity.other.attribute-name.namespace.cs" ] },
    { "VisualStudioItem": "xml doc comment - attribute quotes", "SemanticTokens": [ "xmlDocCommentAttributeQuotes:csharp" ],
      "TextMateScopes": [
        "source.cs comment.block.documentation.cs meta.tag.cs punctuation.definition.string.begin.cs",
        "source.cs comment.block.documentation.cs meta.tag.cs punctuation.definition.string.end.cs" ] },
    { "VisualStudioItem": "xml doc comment - attribute value", "SemanticTokens": [ "xmlDocCommentAttributeValue:csharp" ],
      "TextMateScopes": [ "source.cs comment.block.documentation.cs string.quoted.double.cs", "source.cs comment.block.documentation.cs string.quoted.single.cs" ] },
    { "VisualStudioItem": "xml doc comment - cdata section", "SemanticTokens": [ "xmlDocCommentCDataSection:csharp" ],
      "TextMateScopes": [ "source.cs string.unquoted.cdata.cs" ] },
    { "VisualStudioItem": "xml doc comment - comment", "SemanticTokens": [ "xmlDocCommentComment:csharp" ],
      "TextMateScopes": [ "source.cs comment.block.documentation.cs comment.block.cs" ] },
    { "VisualStudioItem": "xml doc comment - entity reference", "SemanticTokens": [ "xmlDocCommentEntityReference:csharp" ],
      "TextMateScopes": [ "source.cs constant.character.entity.cs", "source.cs punctuation.definition.constant.cs", "source.cs invalid.illegal.bad-ampersand.cs" ] },
    { "VisualStudioItem": "xml doc comment - processing instruction", "SemanticTokens": [ "xmlDocCommentProcessingInstruction:csharp" ] },

    // Types. The TextMate grammar has no record scopes (records get the class/struct scopes)
    // and scopes most type references as entity.name.type.cs, mapped to class name as the common case.
    { "VisualStudioItem": "class name", "SemanticTokens": [ "class:csharp" ],
      "TextMateScopes": [ "source.cs entity.name.type.class.cs", "source.cs entity.name.type.cs", "source.cs entity.name.type.alias.cs" ] },
    { "VisualStudioItem": "record class name", "SemanticTokens": [ "recordClass:csharp" ] },
    { "VisualStudioItem": "struct name", "SemanticTokens": [ "struct:csharp" ], "TextMateScopes": [ "source.cs entity.name.type.struct.cs" ] },
    { "VisualStudioItem": "record struct name", "SemanticTokens": [ "recordStruct:csharp" ] },
    { "VisualStudioItem": "interface name", "SemanticTokens": [ "interface:csharp" ], "TextMateScopes": [ "source.cs entity.name.type.interface.cs" ] },
    { "VisualStudioItem": "enum name", "SemanticTokens": [ "enum:csharp" ], "TextMateScopes": [ "source.cs entity.name.type.enum.cs" ] },
    { "VisualStudioItem": "delegate name", "SemanticTokens": [ "delegate:csharp" ], "TextMateScopes": [ "source.cs entity.name.type.delegate.cs" ] },
    { "VisualStudioItem": "type parameter name", "SemanticTokens": [ "typeParameter:csharp" ], "TextMateScopes": [ "source.cs entity.name.type.type-parameter.cs" ] },
    // The extern alias name is a namespace in Roslyn.
    { "VisualStudioItem": "namespace name", "SemanticTokens": [ "namespace:csharp" ],
      "TextMateScopes": [ "source.cs entity.name.type.namespace.cs", "source.cs variable.other.alias.cs" ] },

    // Members and variables
    { "VisualStudioItem": "method name", "SemanticTokens": [ "method:csharp" ], "TextMateScopes": [ "source.cs entity.name.function.cs" ] },
    { "VisualStudioItem": "extension method name", "SemanticTokens": [ "extensionMethod:csharp" ] },
    { "VisualStudioItem": "property name", "SemanticTokens": [ "property:csharp" ],
      "TextMateScopes": [ "source.cs entity.name.variable.property.cs", "source.cs variable.other.object.property.cs" ] },
    { "VisualStudioItem": "event name", "SemanticTokens": [ "event:csharp" ], "TextMateScopes": [ "source.cs entity.name.variable.event.cs" ] },
    { "VisualStudioItem": "field name", "SemanticTokens": [ "field:csharp" ], "TextMateScopes": [ "source.cs entity.name.variable.field.cs" ] },
    { "VisualStudioItem": "constant name", "SemanticTokens": [ "constant:csharp" ], "TextMateScopes": [ "source.cs variable.other.constant.cs" ] },
    { "VisualStudioItem": "enum member name", "SemanticTokens": [ "enumMember:csharp" ], "TextMateScopes": [ "source.cs entity.name.variable.enum-member.cs" ] },
    // Roslyn sends both "local name" and plain "identifier" (e.g. preprocessor symbols) as `variable`.
    // Unclassified TextMate references are mostly locals and parameters, so they get the local color too.
    { "VisualStudioItem": "local name", "SemanticTokens": [ "variable:csharp" ],
      "TextMateScopes": [
        "source.cs entity.name.variable.local.cs", "source.cs entity.name.variable.range-variable.cs", "source.cs entity.name.variable.tuple-element.cs",
        "source.cs variable.other.readwrite.cs", "source.cs entity.name.variable.preprocessor.symbol.cs" ] },
    { "VisualStudioItem": "parameter name", "SemanticTokens": [ "parameter:csharp" ], "TextMateScopes": [ "source.cs entity.name.variable.parameter.cs", "source.cs variable.other.value.cs" ] },
    { "VisualStudioItem": "label name", "SemanticTokens": [ "label:csharp" ], "TextMateScopes": [ "source.cs entity.name.label.cs" ] },
    // The start of a member access chain (`Console.`, `left.`): could be a type, local or parameter.
    { "VisualStudioItem": "Identifier", "TextMateScopes": [ "source.cs variable.other.object.cs" ] },
    // Additive in VS: only what is set explicitly on "static symbol" is applied on top of the symbol's own color.
    { "VisualStudioItem": "static symbol", "SemanticTokens": [ "*.static:csharp" ] },

    // Regular expressions in strings (no TextMate equivalent)
    { "VisualStudioItem": "regex - alternation", "SemanticTokens": [ "regexAlternation:csharp" ] },
    { "VisualStudioItem": "regex - anchor", "SemanticTokens": [ "regexAnchor:csharp" ] },
    { "VisualStudioItem": "regex - character class", "SemanticTokens": [ "regexCharacterClass:csharp" ] },
    { "VisualStudioItem": "regex - comment", "SemanticTokens": [ "regexComment:csharp" ] },
    { "VisualStudioItem": "regex - grouping", "SemanticTokens": [ "regexGrouping:csharp" ] },
    { "VisualStudioItem": "regex - other escape", "SemanticTokens": [ "regexOtherEscape:csharp" ] },
    { "VisualStudioItem": "regex - quantifier", "SemanticTokens": [ "regexQuantifier:csharp" ] },
    { "VisualStudioItem": "regex - self escaped character", "SemanticTokens": [ "regexSelfEscapedCharacter:csharp" ] },
    { "VisualStudioItem": "regex - text", "SemanticTokens": [ "regexText:csharp" ] },

    // JSON in strings (no TextMate equivalent)
    { "VisualStudioItem": "json - array", "SemanticTokens": [ "jsonArray:csharp" ] },
    { "VisualStudioItem": "json - comment", "SemanticTokens": [ "jsonComment:csharp" ] },
    { "VisualStudioItem": "json - constructor name", "SemanticTokens": [ "jsonConstructorName:csharp" ] },
    { "VisualStudioItem": "json - keyword", "SemanticTokens": [ "jsonKeyword:csharp" ] },
    { "VisualStudioItem": "json - number", "SemanticTokens": [ "jsonNumber:csharp" ] },
    { "VisualStudioItem": "json - object", "SemanticTokens": [ "jsonObject:csharp" ] },
    { "VisualStudioItem": "json - operator", "SemanticTokens": [ "jsonOperator:csharp" ] },
    { "VisualStudioItem": "json - property name", "SemanticTokens": [ "jsonPropertyName:csharp" ] },
    { "VisualStudioItem": "json - punctuation", "SemanticTokens": [ "jsonPunctuation:csharp" ] },
    { "VisualStudioItem": "json - string", "SemanticTokens": [ "jsonString:csharp" ] },
    { "VisualStudioItem": "json - text", "SemanticTokens": [ "jsonText:csharp" ] },
  ],
}
